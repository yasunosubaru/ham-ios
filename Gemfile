source 'https://rubygems.org'

# fastlane 2.240.1 declares `required_ruby_version >= 3.1` in its own gem
# metadata, so a lower floor here only produces a resolver failure at
# `bundle install` time on an otherwise working machine.
ruby ">= 3.1"

# Keep the CocoaPods version aligned with the reproducible iOS CI workflow.
gem 'cocoapods', '1.16.2'
gem 'fastlane', '2.240.1'
gem 'activesupport', '>= 6.1.7.5', '< 7.1.0'
